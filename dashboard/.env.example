# ===========================================================================
# EchoBoard dashboard — frontend configuration
#
# Copy to dashboard/.env.local (gitignored) to override the defaults.
# ===========================================================================

# Base URL of the EchoBoard backend API. The default suits the standard
# setup, where each collaborator runs their own backend locally against the
# shared MongoDB and bucket. Point this elsewhere only if you deploy the
# API to a shared host.
VITE_API_BASE=http://localhost:8000
