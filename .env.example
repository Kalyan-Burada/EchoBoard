# ===========================================================================
# EchoBoard — backend configuration
#
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed. Each collaborator keeps their own .env, but the
# MongoDB and bucket values below must MATCH across the team so everyone
# reads and writes the same dataset.
#
# Setup walkthrough: docs/SHARED_SETUP.md
# ===========================================================================

# ---------------------------------------------------------------------------
# MongoDB Atlas — dataset metadata (ECHD schema)
# ---------------------------------------------------------------------------
# Connection string from Atlas > Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=EchoBoardDB

# ---------------------------------------------------------------------------
# Object storage — the keyframe/board images themselves
# ---------------------------------------------------------------------------
# "s3"    shared S3-compatible bucket (Cloudflare R2, Backblaze B2, Amazon
#         S3, or a self-hosted MinIO). Use this for team work.
# "local" filesystem only, under dataset/echoboard-dataset/. Solo/offline
#         development. Images are NOT visible to collaborators.
STORAGE_BACKEND=s3

# Endpoint host WITHOUT a scheme (no https://).
#   Cloudflare R2   <account-id>.r2.cloudflarestorage.com
#   Backblaze B2    s3.<region>.backblazeb2.com
#   Amazon S3       s3.<region>.amazonaws.com
#   Local MinIO     localhost:9000
S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com

S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>

# Bucket name. Create the bucket once in your provider's console; EchoBoard
# does not create buckets, because API tokens are usually scoped to one.
S3_BUCKET=echoboard-dataset

# "auto" is required by Cloudflare R2. Other providers: use their region
# name (e.g. us-east-1). Ignored by MinIO.
S3_REGION=auto

# "true" for any cloud provider. Set "false" only for a local MinIO on HTTP.
S3_SECURE=true
