# ===========================================================================
# EchoBoard — backend configuration
#
# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed. Each collaborator keeps their own .env, but the
# Supabase values below must MATCH across the team so everyone reads and
# writes the same dataset.
#
# Setup walkthrough: docs/SHARED_SETUP.md
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase project
#
# One Supabase project holds both halves of the dataset: image metadata in
# PostgreSQL and the image files in Storage.
#
# Find these in Supabase Dashboard > Project Settings > API.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co

# The service_role key. It bypasses Row Level Security, so it is a full
# administrative credential: keep it server-side, never put it in the
# dashboard/frontend, and never commit it. (Do NOT use the anon key here —
# the tables have RLS enabled with no policies, so anon access is denied.)
SUPABASE_SERVICE_KEY=<service-role-key>

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# "supabase" shared Supabase Storage bucket. Use this for team work.
# "local"    filesystem only, under dataset/echoboard-dataset/. Solo or
#            offline development. Images are NOT visible to collaborators.
STORAGE_BACKEND=supabase

# Storage bucket name. Created automatically on first start if the
# service_role key permits it; otherwise create it (private) in
# Supabase Dashboard > Storage.
SUPABASE_BUCKET=echoboard-dataset

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API. The defaults cover the
# Vite dev server and a local production preview.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
